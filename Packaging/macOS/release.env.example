# Copy this file to Packaging/macOS/release.env and fill in real values.

VERSION=1.0.0
BUILD_NUMBER=1
BUNDLE_IDENTIFIER=com.rleungx.Glance

# Sparkle feed configuration
APPCAST_URL=https://updates.example.org/appcast.xml
SPARKLE_PUBLIC_ED_KEY=REPLACE_WITH_SPARKLE_PUBLIC_KEY
DOWNLOAD_BASE_URL=https://downloads.example.org/releases/1.0.0
SPARKLE_PRIVATE_KEY_FILE=$HOME/.config/sparkle/ed25519.pem

# Apple signing / notarization
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
NOTARY_PROFILE=glance-notary

# Optional overrides
# DIST_DIR=$PWD/dist
# BUILD_CONFIGURATION=release
# ENTITLEMENTS_FILE=$PWD/Packaging/macOS/Glance.entitlements
